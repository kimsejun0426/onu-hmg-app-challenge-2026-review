      "expected_audio_sha256": "8ac33d6eaaa680ef4a9ffc6966adda0e0f4daeb07d56a523259b3cb893cf5c77",
      "selected_attempt": 1
    },
    {
      "id": "dino_350bcbfbd123f73b",
      "text": "물가에 바퀴 자국이 나 있어. 오누도 옆에서 흔적을 찾아볼게.",
      "text_sha256": "350bcbfbd123f73b736827882a324bd6934adac919e7299a7b2332a70df2d3f4",
      "asset": "story_audio/dino_350bcbfbd123f73b.wav",
