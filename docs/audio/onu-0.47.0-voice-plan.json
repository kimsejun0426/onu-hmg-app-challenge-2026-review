      "expected_audio_sha256": "9abce5970f39677bcc85fae5506c1164dd08ee2df0ce8958c1a8a851745186f5",
      "selected_attempt": 1
    },
    {
      "id": "dino_32fcb4b6f679647b",
      "text": "오누가 돋보기를 잡았어.",
      "text_sha256": "32fcb4b6f679647b93b146a990a1bbff8e67f45a20b3c63b83e3cc0ea7dc23eb",
      "asset": "story_audio/dino_32fcb4b6f679647b.wav",
